<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarResa"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="Réserver"
        app:titleTextColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarResa"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgSelectedService"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"/>

            <TextView
                android:id="@+id/txtServiceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="18sp"
                android:paddingTop="8dp"/>

            <!-- Date -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Date" android:paddingTop="12dp"/>
            <EditText
                android:id="@+id/edtDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:hint="Sélectionner une date"/>

            <!-- Time -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Heure" android:paddingTop="12dp"/>
            <EditText
                android:id="@+id/edtTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:hint="Sélectionner une heure"/>

            <!-- Address -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Adresse" android:paddingTop="12dp"/>
            <EditText
                android:id="@+id/edtAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Adresse (ou utiliser la localisation)"/>
            <Button
                android:id="@+id/btnUseLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Utiliser ma position actuelle"
                android:layout_marginTop="8dp"/>

            <!-- Photos (optionnelles) -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Photos (optionnel)" android:paddingTop="12dp"/>
            <Button
                android:id="@+id/btnAttachPhotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Joindre des photos"/>
            <TextView
                android:id="@+id/txtPhotosCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="Aucune photo jointe"/>

            <Button
                android:id="@+id/btnSubmitResa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Valider la réservation"
                android:layout_marginTop="20dp"/>
        </LinearLayout>
    </ScrollView>


    <!-- Bottom navigation (remplace ton GridLayout) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/primary"
        app:itemTextColor="@color/primary"
        android:background="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
